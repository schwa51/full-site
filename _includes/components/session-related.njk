{# _includes/components/session-related.njk #}
{# Inputs (optional):
   - system: system slug or pretty name ("echoes" or "Echoes Beneath the Mountains")
   - session:  session slug/id (defaults to this page's fileSlug)
   - showGM:   true to include GM entries in the GM build
#}

{% set campRaw = system is defined and system or (data and data.system) or "" %}
{% set camp    = (campRaw | slug) %}

{% set sessId  = (session is defined and session) 
                  or (data and data.session) 
                  or (page and page.fileSlug) %}

{% set base = (collections.system_content if GM_MODE and showGM else collections.public_content) or [] %}
{% set related = base | bysystem(camp) | where("data.session", sessId) | sortBy("data.title") %}

{% set npcs = related | where("data.section", "npcs") %}
{% set items = related | where("data.section", "items") %}
{% set lore = related | where("data.section", "lore") %}
{% set locs = related | where("data.section", "locations") %}

{% macro relatedGroup(title, entries) %}
  <section>
    <h2>{{ title }} ({{ entries | length }})</h2>
    {% if entries | length %}
      <ul>
        {% for entry in entries %}
          {% set url = (entry.url | gmHref) if entry.data.gm == true else entry.url %}
          <li><a href="{{ url }}">{{ entry.data.title }}</a></li>
        {% endfor %}
      </ul>
    {% endif %}
  </section>
{% endmacro %}

{% if npcs.length or items.length or lore.length or locs.length %}
  <hr/>
  {{ relatedGroup("People met", npcs) }}
  {{ relatedGroup("Items discovered", items) }}
  {{ relatedGroup("Lore & discoveries", lore) }}
  {{ relatedGroup("Locations visited", locs) }}
{% endif %}
