<section id="arkham-character-manager" class="arkham-manager" aria-label="Arkham Horror character manager">
  <noscript>This character manager requires JavaScript. Existing written character dossiers remain available below.</noscript>
</section>

{% set systemKey = systemSlug or (system | slug) %}
{% set section = type | slug %}
{% set items = (collections.public_content or []) | bysystem(systemKey) | where("data.section", section) | sortBy("data.title") %}
{% set currentUrl = page.url or '' %}
{% set currentPath = page.inputPath %}
{% set sectionIndexUrl = "/vault/systems/" + systemKey + "/" + section + "/" %}

<details class="arkham-written-dossiers">
  <summary>Written character dossiers</summary>
  <ul class="list">
    {% for it in items %}
      {% set isSelfOrIndex = (it.inputPath == currentPath) or (it.url == currentUrl) or (it.url == sectionIndexUrl) or (it.page and it.page.fileSlug == "index") %}
      {% if not isSelfOrIndex %}<li><a href="{{ it.url }}">{{ it.data.title }}</a></li>{% endif %}
    {% endfor %}
  </ul>
</details>

