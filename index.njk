---
title: It's a Magical World...
subtitle: ...let's go exploring!
layout: layout.njk
theme: main
publish: true
no_heading_border: true
eleventyNavigation:
  key: Home
  order: 10
---
{% macro campaignCards(group, emptyMessage, linkClass = "") %}
  {% set games = collections.homepage_campaigns | where("data.homepageCampaign.group", group) %}
  {% if games.length %}
    <ul class="cards">
      {% for game in games %}
        <li><a{% if linkClass %} class="{{ linkClass }}"{% endif %} href="{{ game.url }}">{{ game.data.homepageCampaign.title or game.data.title }}</a></li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="muted">{{ emptyMessage }}</p>
  {% endif %}
{% endmacro %}

<div class="section-grid">
<section class="section-card" data-section="active">
<h2>Active Campaigns</h2>
{{ campaignCards("active", "No active campaign set.", "btn") }}
</section>

<section class="section-card" data-section="future-games" id="possible-future-games">
  <h2><a href="/vault/future-games/">Possible Future Games</a></h2>
  <ul class="cards">
    {% for game in collections['future-games'] | sortBy('data.future_game_order') %}
      <li><a href="{{ game.url }}">{{ game.data.title }}</a></li>
    {% endfor %}
  </ul>
</section>

<section class="section-card" data-section="past">
  <h2>Past Campaigns</h2>
  {{ campaignCards("past", "No past games configured.") }}
</section>
</div>

<section class="section-card" data-section="rpg-library">
  <h2>RPG Library</h2>
  <p>Browse other tabletop roleplaying games in my collection.</p>
  <ul class="cards">
    <li><a href="/vault/games/">Explore games</a></li>
  </ul>
</section>

<section class="section-card" data-section="mtg">
  <h2>Magic: The Gathering</h2>
  <ul class="list">
    <li><a href="/vault/mtg/pauper/">Pauper</a></li>
    <li><a href="/vault/mtg/commander/">Commander</a></li>
    <li><a href="/vault/mtg/cube/">Cube</a></li>
  </ul>
</section>
